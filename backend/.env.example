MONGO_URL=mongodb://localhost:27017
DB_NAME=atelier
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
DEFAULT_TENANT_SLUG=atelier
# Generate a random secret of at least 32 characters for production.
# RATE_LIMIT_SECRET=
# Comma-separated trusted reverse-proxy IPs/CIDRs. Do not trust client-supplied
# forwarding headers unless requests arrive from these addresses.
# TRUSTED_PROXY_IPS=
# PLATFORM_OWNER_EMAIL and PLATFORM_OWNER_PASSWORD are required for master access.
# Set both values locally to enable the platform owner account and tenant provisioning.
# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=
# Password recovery e-mail settings (required in production)
# PUBLIC_APP_URL=https://your-domain.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=Atelier <no-reply@your-domain.example>
