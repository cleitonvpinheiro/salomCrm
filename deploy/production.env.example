# Copie para deploy/production.env (ignorado pelo Git) e preencha no servidor.
# Execute: docker compose --env-file deploy/production.env -f docker-compose.prod.yml up -d --build

# Dominio publico sem esquema; o Caddy emite o certificado HTTPS automaticamente.
SITE_ADDRESS=app.example.com
PUBLIC_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Use um banco exclusivo de producao (nunca o de desenvolvimento/testes).
MONGO_URL=mongodb+srv://USUARIO:SENHA@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=atelier_prod
DEFAULT_TENANT_SLUG=meu-salao
APP_TZ=America/Sao_Paulo

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_SECRET=
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=Platform Owner
# Minimo de 16 caracteres.
PLATFORM_OWNER_PASSWORD=

# Recuperacao de senha por e-mail (obrigatorio em producao).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Atelier <no-reply@example.com>
